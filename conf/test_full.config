/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/plasmodiumdrugres -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    allele_table         = params.pipelines_testdata_base_path + 'testdata/allele_table.tsv'
    panel_info_bed       = params.pipelines_testdata_base_path + 'testdata/panel_info.bed'
    loci_of_interest_bed = params.pipelines_testdata_base_path + 'testdata/loci_of_interest.bed'
    loci_groups          = params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv'
}
