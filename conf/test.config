/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/plasmodiumdrugres -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    allele_table         = params.pipelines_testdata_base_path + 'testdata/allele_table.tsv'
    panel_info_bed       = params.pipelines_testdata_base_path + 'testdata/panel_info.bed'
    loci_of_interest_bed = params.pipelines_testdata_base_path + 'testdata/loci_of_interest.bed'
    loci_groups          = params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv'
}
