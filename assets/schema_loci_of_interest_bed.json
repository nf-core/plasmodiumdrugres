{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/plasmodiumdrugres/main/assets/schema_loci_of_interest_bed.json",
    "title": "nf-core/plasmodiumdrugres pipeline - params.loci_of_interest_bed schema",
    "description": "Codon BED for params.loci_of_interest_bed. Required columns: #chrom, start, end, strand, gene_id, aa_position. name, length, and gene are optional. Each locus must span 3 bases (end - start == 3).",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "#chrom": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Chromosome that the loci of interest is on.",
                "meta": ["id"]
            },
            "start": {
                "type": "integer",
                "errorMessage": "Zero-based codon start coordinate.",
                "meta": ["id"]
            },
            "end": {
                "type": "integer",
                "errorMessage": "Zero-based codon end coordinate.",
                "meta": ["id"]
            },
            "length": {
                "type": "integer",
                "errorMessage": "Length of the codon in base pairs. Optional; the codon span is end - start and must be 3.",
                "meta": ["id"]
            },
            "strand": {
                "type": "string",
                "pattern": "^[+-]$",
                "errorMessage": "Strand that the codon of interest is on.",
                "meta": ["id"]
            },
            "name": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Codon name. Optional.",
                "meta": ["id"]
            },
            "gene": {
                "type": "string",
                "errorMessage": "Gene name.",
                "pattern": "^\\S+$",
                "meta": ["id"]
            },
            "gene_id": {
                "type": "string",
                "errorMessage": "ID of the gene the codon is on.",
                "pattern": "^\\S+$",
                "meta": ["id"]
            },
            "aa_position": {
                "type": "integer",
                "errorMessage": "Amino acid position. Required.",
                "meta": ["id"]
            }
        },
        "required": ["#chrom", "start", "end", "strand", "gene_id", "aa_position"]
    }
}
