nextflow_workflow {

    name "Test Workflow PLASMODIUMDRUGRES"
    script "workflows/plasmodiumdrugres.nf"
    workflow "PLASMODIUMDRUGRES"

    test("Should run without failures - MLBM and naive slaf") {

        when {
            params {
                population_assignment = null
                population_label = "pop1"
            }
            workflow {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true))
                input[1] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/panel_info.bed', checkIfExists: true))
                input[2] = params.pipelines_testdata_base_path + 'testdata/loci_of_interest.bed'
                input[3] = null
                input[4] = null
                input[5] = "MLBM"
                input[6] = params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv'
                input[7] = "naive"
                input[8] = channel.empty()
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 7
        }

    }

    test("Should run without failures - FEM and IDM") {

        when {
            params {
                population_assignment = null
                population_label = "pop1"
            }
            workflow {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true))
                input[1] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/panel_info.bed', checkIfExists: true))
                input[2] = params.pipelines_testdata_base_path + 'testdata/loci_of_interest.bed'
                input[3] = null
                input[4] = null
                input[5] = "FEM"
                input[6] = params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv'
                input[7] = "IDM"
                input[8] = channel.empty()
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 7
        }

    }

    test("Should run without failures - NAIVE multilocus and mhaps_freq for slaf") {

        when {
            params {
                population_assignment = null
                population_label = "pop1"
            }
            workflow {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true))
                input[1] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/panel_info.bed', checkIfExists: true))
                input[2] = params.pipelines_testdata_base_path + 'testdata/loci_of_interest.bed'
                input[3] = null
                input[4] = null
                input[5] = "naive"
                input[6] = params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv'
                input[7] = "mhaps_freq"
                input[8] = channel.empty()
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 7
        }

    }

    test("Should run without failures - NAIVE multilocus and mhaps_freq for slaf with multi populations") {

        when {
            params {
                population_assignment = params.pipelines_testdata_base_path + 'testdata/population_assignment.tsv'
            }
            workflow {
                """
                input[0] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true))
                input[1] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/panel_info.bed', checkIfExists: true))
                input[2] = params.pipelines_testdata_base_path + 'testdata/loci_of_interest.bed'
                input[3] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/population_assignment_indexed.tsv', checkIfExists: true))
                input[4] = channel.of(file(params.pipelines_testdata_base_path + 'testdata/population_index_lookup.tsv', checkIfExists: true))
                input[5] = "naive"
                input[6] = params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv'
                input[7] = "mhaps_freq"
                input[8] = channel.empty()
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 19
        }

    }

}
