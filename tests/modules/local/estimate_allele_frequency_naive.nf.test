nextflow_process {

    name "Test Process ESTIMATE_ALLELE_FREQUENCY_NAIVE"
    script "modules/local/estimate_allele_frequency_naive/main.nf"
    process "ESTIMATE_ALLELE_FREQUENCY_NAIVE"

    test("Estimating allele frequencies naively should run without failures with read_count_prop method") {

        when {
            process {
                """
                // define inputs of the process here. Example:
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                input[1] = "read_count_prop"
                """
            }
        }

        then {
            assert process.success
            // channel exists
            assert process.out.slaf != null

            // unpack tuple output
            def (pop, outFile) = process.out.slaf.get(0)

            assert pop == 'amino_acid_calls'

            // output md5 check
            assert path(outFile).md5 == "48059e04968526e08f508d7e771f02af"
        }

    }
    test("Estimating allele frequencies naively should run without failures with presence_absence method") {

        when {
            process {
                """
                // define inputs of the process here. Example:
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                input[1] = "presence_absence"
                """
            }
        }

        then {
            assert process.success
            // channel exists
            assert process.out.slaf != null

            // unpack tuple output
            def (pop, outFile) = process.out.slaf.get(0)

            assert pop == 'amino_acid_calls'

            // output md5 check
            assert path(outFile).md5 == "07b4d1c4f728f15dcc8332af1675eaa5"

        }
    }
}
