nextflow_process {

    name "Test Process EXTRACT_PANEL_INFO_TO_BED"
    script "modules/local/extract_panel_info_to_bed/main.nf"
    process "EXTRACT_PANEL_INFO_TO_BED"

    test("Should extract panel info without failures") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/example_PMO.json', checkIfExists: true)
                input[1] = "FALSE"
                """
            }
        }

        then {
            assert process.success
            assert process.out.panel_info_bed != null
            assert path(process.out.panel_info_bed.get(0)).md5 == "bfca8b5369eac771e91c7f9404ef56b9"
        }

    }

    test("Should extract panel info with add_ref_seqs without failures") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/example_PMO.json', checkIfExists: true)
                input[1] = "TRUE"
                """
            }
        }

        then {
            assert process.success
            assert process.out.panel_info_bed != null
            assert path(process.out.panel_info_bed.get(0)).md5 == "d991e06e47f68430e23080ec57d493c3"
        }

    }

}
