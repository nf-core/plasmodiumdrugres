nextflow_process {

    name "Test Process DCIFER_SLAF_WRAPPER"
    script "modules/local/dcifer_slaf_wrapper/main.nf"
    process "DCIFER_SLAF_WRAPPER"

    test("Test for failures and output file checksums with allele_table") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert process.out.mhaps_slaf != null
            // unpack tuple output
            def (pop, outFile) = process.out.mhaps_slaf.get(0)

            assert pop == 'allele_table'

            // output md5 check
            assert path(outFile).md5 == "5782bf466d5ca3228baffca3a9147110"
        }

    }

    test("Test for failures and output file checksums with allele_table coi_lrank 1") {

        when {
            params{
                dcifer_slaf_wrapper_coi_lrank = 1
            }
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert process.out.mhaps_slaf != null
            // unpack tuple output
            def (pop, outFile) = process.out.mhaps_slaf.get(0)

            assert pop == 'allele_table'

            // output md5 check
            assert path(outFile).md5 == "5782bf466d5ca3228baffca3a9147110"
        }

    }

}
