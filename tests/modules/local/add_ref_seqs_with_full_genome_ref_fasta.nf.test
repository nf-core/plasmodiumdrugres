nextflow_process {

    name "Test Process ADD_REF_SEQS_WITH_FULL_GENOME_REF_FASTA"
    script "modules/local/add_ref_seqs_with_full_genome_ref_fasta/main.nf"
    process "ADD_REF_SEQS_WITH_FULL_GENOME_REF_FASTA"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/dummy_panel_info_fake_chroms.bed', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/insert_refseqs.fasta', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            // channel exists
            assert process.out.ref_bed_with_seqs != null
            // output md5 check
            assert path(process.out.ref_bed_with_seqs.get(0)).md5 == "b8451c64d69abf10cb2978c6b782dbe7"
        }

    }

}
