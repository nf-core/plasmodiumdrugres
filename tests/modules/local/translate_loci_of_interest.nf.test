nextflow_process {

    name "Test Process TRANSLATE_LOCI_OF_INTEREST"
    script "modules/local/translate_loci_of_interest/main.nf"
    process "TRANSLATE_LOCI_OF_INTEREST"

    test("Should run without failures") {

        when {
            params {
                collapse_calls_by_summing = false
            }
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/panel_info.bed', checkIfExists: true)
                input[2] = file(params.pipelines_testdata_base_path + 'testdata/loci_of_interest.bed', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            // channel exists
            assert process.out.collapsed_amino_acid_calls != null
            // output md5 check
            assert path(process.out.collapsed_amino_acid_calls.get(0)).md5 == "3f0406da2b491b57c966f100f75344c4"
            assert path(process.out.amino_acid_calls.get(0)).md5 == "8ceb411243ca723b50789091364a2806"
            assert path(process.out.loci_covered_by_target_samples_info.get(0)).md5 == "1b2c20818014cb785d013fc21ff46346"
            assert path(process.out.loci_of_interest_for_target_for_microhap.get(0)).md5 == "9edf5e426dffd32eb3acbd6d7394671b"

        }

    }

}
