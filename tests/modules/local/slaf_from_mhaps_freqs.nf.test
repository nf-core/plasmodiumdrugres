nextflow_process {

    name "Test Process SLAF_FROM_MHAPS_FREQS"
    script "modules/local/slaf_from_mhaps_freqs/main.nf"
    process "SLAF_FROM_MHAPS_FREQS"

    test("Test for failures and output file checksums with loci_of_interest_mhaps.tsv and mhaps_slaf.tsv") {

        when {
            process {
                """
                input[0] = tuple("mhaps_slaf", file(params.pipelines_testdata_base_path + 'testdata/mhaps_slaf.tsv', checkIfExists: true))
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/loci_of_interest_mhaps.bed', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert process.out.slaf != null
            // unpack tuple output
            def (pop, outFile) = process.out.slaf.get(0)

            assert pop == 'mhaps_slaf'

            // output md5 check
            assert path(outFile).md5 == "509a889363651b4523bc6d00087273e8"
        }

    }

}
