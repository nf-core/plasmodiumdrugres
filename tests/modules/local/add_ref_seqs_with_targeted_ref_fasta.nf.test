nextflow_process {

    name "Test Process ADD_REF_SEQS_WITH_TARGETED_REF_FASTA"
    script "modules/local/add_ref_seqs_with_targeted_ref_fasta/main.nf"
    process "ADD_REF_SEQS_WITH_TARGETED_REF_FASTA"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/panel_info_no_ref.bed', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/insert_refseqs.fasta', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            // channel exists
            assert process.out.ref_bed_with_seqs != null
            // output md5 check
            assert path(process.out.ref_bed_with_seqs.get(0)).md5 == "d991e06e47f68430e23080ec57d493c3"
        }

    }

}
