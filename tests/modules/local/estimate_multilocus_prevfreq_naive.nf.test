nextflow_process {

    name "Test Process ESTIMATE_ML_PREVFREQ_NAIVE"
    script "modules/local/estimate_multilocus_prevfreq_naive/main.nf"
    process "ESTIMATE_ML_PREVFREQ_NAIVE"

    test("Estimating multilocus prev and frequency naively small example file, wsaf_prop method, should run without failures") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv', checkIfExists: true)
                input[2] = "wsaf_prop"
                """
            }
        }

        then {
            assert process.success
            assert process.out.mlaf != null
            assert process.out.slaf_from_mlaf != null

            // unpack tuple output
            def (pop, outFile_ml) = process.out.mlaf.get(0)
            def (pop_again, outFile_sl) = process.out.slaf_from_mlaf.get(0)

            assert pop == 'amino_acid_calls'
            assert pop_again == 'amino_acid_calls'

            // output md5 check
            assert path(outFile_ml).md5 == "cf0d6d097ee3bdf91bb63d31da07aece"
            assert path(outFile_sl).md5 == "1e7a191bd60aad3d650784e82b75f411"

        }

    }

    test("Estimating multilocus prev and frequency naively small example file, wsaf_prop method, should run without failures") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv', checkIfExists: true)
                input[2] = "presence_absence"
                """
            }
        }

        then {
            assert process.success
            assert process.out.mlaf != null
            assert process.out.slaf_from_mlaf != null

            // unpack tuple output
            def (pop, outFile_ml) = process.out.mlaf.get(0)
            def (pop_again, outFile_sl) = process.out.slaf_from_mlaf.get(0)

            assert pop == 'amino_acid_calls'
            assert pop_again == 'amino_acid_calls'

            // output md5 check
            assert path(outFile_ml).md5 == "79b9e0390b6d0146bb3879050438cc1f"
            assert path(outFile_sl).md5 == "3c62c84138d933578150ee279bfab74c"

        }

    }
}
