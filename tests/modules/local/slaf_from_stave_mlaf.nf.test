nextflow_process {

    name "Test Process SLAF_FROM_STAVE_MLAF"
    script "modules/local/slaf_from_stave_mlaf/main.nf"
    process "SLAF_FROM_STAVE_MLAF"

    test("Test for successful execution and output checksum") {

        when {
            process {
                """
                input[0] = tuple(file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.aa_mlaf.tsv').getBaseName(3), file(params.pipelines_testdata_base_path + 'testdata/aa_mlaf.tsv', checkIfExists: true))
                """
            }
        }

        then {
            assert process.success
            assert process.out.slaf != null

            // unpack tuple output
            def (pop, outFile) = process.out.slaf.get(0)

            assert pop == 'aa_mlaf'

            // output md5 check
            assert path(outFile).md5 == "16905e7b896609a5bfccc2c271cb46ef"
        }

    }

}
