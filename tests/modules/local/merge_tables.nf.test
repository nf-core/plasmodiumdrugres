nextflow_process {

    name "Test Process MERGE_TABLES"
    script "modules/local/merge_tables/main.nf"
    process "MERGE_TABLES"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = tuple('pop1', [
                file(params.pipelines_testdata_base_path + 'testdata/allele_prev.tsv', checkIfExists: true),
                file(params.pipelines_testdata_base_path + 'testdata/aa_mlaf.tsv', checkIfExists: true),
                file(params.pipelines_testdata_base_path + 'testdata/aa_slaf.tsv', checkIfExists: true),
                file(params.pipelines_testdata_base_path + 'testdata/sl_from_ml.tsv', checkIfExists: true)])
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/empty_population_index_lookup.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            // channel exists
            assert process.out.sl_summary != null
            assert process.out.ml_summary != null
            assert process.out.sl_from_ml_summary != null

            // output md5 check
            assert path(process.out.sl_summary.get(0)).md5 == "28bca06f0b8b9f3561eb407fd02764af"
            assert path(process.out.ml_summary.get(0)).md5 == "cd4642adbd28904af2103bcca15660dc"
            assert path(process.out.sl_from_ml_summary.get(0)).md5 == "ef3b5a5e93d31e498c61462f6fe443f8"

        }

    }

    test("Should produce empty ML summaries when MLAF outputs are absent") {

        when {
            process {
                """
                input[0] = tuple('pop1', [
                file(params.pipelines_testdata_base_path + 'testdata/allele_prev.tsv', checkIfExists: true),
                file(params.pipelines_testdata_base_path + 'testdata/aa_slaf.tsv', checkIfExists: true)])
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/empty_population_index_lookup.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.ml_summary.get(0)).text == "population\tgroup_id\tvariant\tfreq\n"
            assert path(process.out.sl_from_ml_summary.get(0)).text == "population\tgroup_id\tvariant\tsample_total\tallele_total\tallele_count\tsample_count\tfreq\tprev\n"
        }

    }

    test("Should restore true population labels from index lookup") {

        when {
            process {
                """
                input[0] = tuple('popidx_001', [
                file(params.pipelines_testdata_base_path + 'testdata/allele_prev.tsv', checkIfExists: true),
                file(params.pipelines_testdata_base_path + 'testdata/aa_mlaf.tsv', checkIfExists: true),
                file(params.pipelines_testdata_base_path + 'testdata/aa_slaf.tsv', checkIfExists: true),
                file(params.pipelines_testdata_base_path + 'testdata/sl_from_ml.tsv', checkIfExists: true)])
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/population_index_lookup.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.sl_summary.get(0)).text.contains("Vietnam_201801-01")
            assert path(process.out.ml_summary.get(0)).text.contains("Vietnam_201801-01")
            assert path(process.out.sl_from_ml_summary.get(0)).text.contains("Vietnam_201801-01")
        }

    }

}
