nextflow_process {

    name "Test Process ESTIMATE_ALLELE_PREVALENCE_NAIVE"
    script "modules/local/estimate_allele_prevalence_naive/main.nf"
    process "ESTIMATE_ALLELE_PREVALENCE_NAIVE"

    test("Estimate allele prev should run without failures") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            // channel exists
            assert process.out.allele_prevalence != null

            // unpack tuple output
            def (pop, outFile) = process.out.allele_prevalence.get(0)

            assert pop == 'amino_acid_calls'

            // output md5 check
            assert path(outFile).md5 == "7fd98b0413f895d1daa3f978aad74912"
        }

    }

}
