nextflow_process {

    name "Test Process IDM_WRAPPER"
    script "modules/local/idm_wrapper"
    process "IDM_WRAPPER"

    test("Test for failures and output file checksums") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/input/example_amino_acid_calls.tsv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.slaf != null
            // unpack tuple output
            def (pop, outFile) = process.out.slaf.get(0)

            assert pop == 'example_amino_acid_calls'

            // output md5 check
            assert path(outFile).md5 == "52cb67a7afe69a8a68a109a6be0a7cc7"
        }

    }

}
