nextflow_process {

    name "Test Process IDM_WRAPPER"
    script "modules/local/idm_wrapper/main.nf"
    process "IDM_WRAPPER"

    test("Test for failures and output file checksums") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert process.out.slaf != null
            // unpack tuple output
            def (pop, outFile) = process.out.slaf.get(0)

            assert pop == 'amino_acid_calls'

            // output md5 check
            assert path(outFile).md5 == "fe4b08c03c4cf43bbaf35d8fed1240d2"
        }

    }

}
