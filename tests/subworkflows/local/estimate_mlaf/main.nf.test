nextflow_workflow {

    name "Test Workflow ESTIMATE_MLAF"
    script "subworkflows/local/estimate_mlaf/main.nf"
    workflow "ESTIMATE_MLAF"

    test("Should run without failures with MLBM method") {

        when {
            workflow {
                """
                input[0] = "MLBM"
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                input[2] = file(params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 2
        }

    }
    test("Should run without failures with FEM method") {

        when {
            workflow {
                """
                input[0] = "FEM"
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                input[2] = file(params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 2
        }

    }
    test("Should fail with incorrect method") {

        when {
            workflow {
                """
                input[0] = "BAD_METHOD"
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/amino_acid_calls.tsv', checkIfExists: true)
                input[2] = file(params.pipelines_testdata_base_path + 'testdata/loci_groups.tsv', checkIfExists: true)
                """
            }
        }
        then {
            // assert that it failed
            assert !workflow.success
        }

    }

}
